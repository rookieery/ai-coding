// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  email     String?  @unique
  username  String   @unique
  password  String
  avatar    String?
  rating    Int      @default(1200)
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  games         Game[]        @relation("UserGames")
  hostedRooms   Room[]        @relation("HostRooms")
  guestedRooms  Room[]        @relation("GuestRooms")
  roomMessages  RoomMessage[]
  blackMatches  Match[]       @relation("BlackMatches")
  whiteMatches  Match[]       @relation("WhiteMatches")
}

model Game {
  id          String   @id @default(cuid())
  title       String
  description String?
  boardSize   Int      @default(15)
  moves       String   @db.Text
  result      String?
  playerBlack String?
  playerWhite String?
  isPublic    Boolean  @default(true)
  gameType    String   @default("gomoku")
  tags        String   @db.Text
  metadata    String?  @db.Text

  authorId String?
  author   User?  @relation("UserGames", fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Match {
  id          String   @id @default(cuid())
  type        String
  mode        String
  boardSize   Int      @default(15)

  playerBlackId   String?
  playerBlackName String
  playerBlackType String
  playerWhiteId   String?
  playerWhiteName String
  playerWhiteType String

  aiLevelBlack Int?
  aiLevelWhite Int?

  moves    String   @db.Text
  result   String?
  duration Int?

  blackCaptures Int @default(0)
  whiteCaptures Int @default(0)

  createdAt DateTime @default(now())
  endedAt   DateTime?

  playerBlack User? @relation("BlackMatches", fields: [playerBlackId], references: [id], onDelete: SetNull)
  playerWhite User? @relation("WhiteMatches", fields: [playerWhiteId], references: [id], onDelete: SetNull)
}

model Room {
  id        String   @id @default(cuid())
  name      String
  status    String   @default("waiting")
  gameType  String   @default("gomoku")
  boardSize Int      @default(15)
  ruleMode  String   @default("standard")
  maxSpectators Int  @default(50)
  isPublic  Boolean  @default(true)

  hostId    String?
  host      User?    @relation("HostRooms", fields: [hostId], references: [id], onDelete: SetNull)
  hostColor String   @default("black")

  guestId   String?
  guest     User?    @relation("GuestRooms", fields: [guestId], references: [id], onDelete: SetNull)

  boardState String  @db.LongText
  moves      String  @db.Text
  currentPlayer String @default("black")
  winner     String?
  lastMoveAt DateTime?
  disconnectTimeoutAt DateTime?
  moveCount  Int     @default(0)
  spectatorCount Int @default(0)
  isRanked   Boolean @default(false)
  matchId    String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages   RoomMessage[]

  @@index([status])
  @@index([hostId])
  @@index([isPublic, status])
}

model RoomMessage {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  username  String
  content   String
  channel   String   @default("players")
  createdAt DateTime @default(now())

  @@index([roomId, channel, createdAt])
  @@index([roomId, createdAt])
}
